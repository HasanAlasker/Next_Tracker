generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// when you use prisma you don't have to redefine types for models and enums you have here
// just use these as types

model User {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  password   String
  issues     Issue[]  @relation("CreatedIssues")
  assignedTo Issue[]  @relation("AssignedIssues")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Issue {
  id           Int      @id @default(autoincrement())
  title        String   @db.VarChar(255)
  description  String   @db.Text
  status       Status   @default(OPEN)
  author       User     @relation("CreatedIssues", fields: [authorId], references: [id])
  authorId     Int
  assignTo     User     @relation("AssignedIssues", fields: [assignedToId], references: [id])
  assignedToId Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Status {
  OPEN
  IN_PROGRESS
  CLOSED
}
